# SmartQuotation — drill semanal de restore (ordem 002).
# Restaura o dump mais recente num postgres:15 efêmero (--network none, --rm), confere schema
# engematex, tabelas-chave e cotações, valida o tar de mídia, confere (sem baixar) que o dump
# mais novo enviado está no off-site com o hash registrado, e grava restore_last_success.
# Falha = unit "failed" (systemctl --failed / journal). Ver docs/INFRASTRUCTURE.md §6.

[Unit]
Description=SmartQuotation: drill semanal de restore do backup
Documentation=file:///opt/smartquotation/docs/INFRASTRUCTURE.md
Requires=docker.service
After=docker.service sq-backup.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# User=root pelo mesmo motivo do sq-backup.service: o deploy não está no grupo docker,
# e o drill precisa do socket do docker para subir o container efêmero.
User=root
# Mesmo env file dedicado do sq-backup.service (só variáveis de backup).
EnvironmentFile=/etc/smartquotation/backup.env
# Marcador explícito "estou numa unit de backup": RESTORE_DUMP_FILE/RESTORE_MEDIA_FILE (drill
# manual) são recusados aqui.
Environment=SQ_BACKUP_UNIT=1
WorkingDirectory=/opt/smartquotation
UMask=0077
ExecStart=/opt/smartquotation/scripts/restore_check.sh
TimeoutStartSec=2h

ProtectSystem=strict
# RCLONE_CACHE_DIR: a conferência do off-site usa o rclone (o home do root é read-only).
ReadWritePaths=/backups/sq /var/lib/smartquotation/offsite-cache
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
