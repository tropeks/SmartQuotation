# Ambiente das units sq-backup.service e sq-restore-check.service.
# Destino no host: /etc/smartquotation/backup.env, dono root, modo 0600:
#   install -d -m 0700 /etc/smartquotation
#   install -m 0600 -o root -g root ops/systemd/backup.env.example /etc/smartquotation/backup.env
#
# SÓ variáveis de backup. Este arquivo existe para que as units NÃO carreguem o ambiente da
# aplicação: nada de FIELD_ENCRYPTION_KEY, DJANGO_SECRET_KEY, POSTGRES_PASSWORD nem AWS_*
# aqui. Os scripts tiram o que precisam de dentro dos próprios containers (a senha do banco
# do env do sq-prod-db, a chave do env do sq-web-proto), nunca daqui.
#
# POSTGRES_USER não é definido de propósito: no modo container o dump usa o POSTGRES_USER do
# próprio sq-prod-db. (O modo compose exige POSTGRES_USER/POSTGRES_DB; produção não usa compose.)
# Não defina DOCKER com sudo: a unit roda como root e NoNewPrivileges bloqueia sudo.

# ─── Destinos (têm de bater com ReadWritePaths das units) ─────────────────────
BACKUP_DIR=/backups/sq
KEY_BACKUP_DIR=/var/lib/smartquotation/key-backup
BACKUP_RETENTION_DAYS=14

# ─── Containers de produção (avulsos, sem compose) ────────────────────────────
DB_CONTAINER=sq-prod-db
DB_CONTAINER_PORT=5436
MEDIA_CONTAINER=sq-web-proto
WEB_CONTAINER=sq-web-proto
# BACKUP_MODE=auto                  # auto | container | compose

# ─── Validação por conteúdo ───────────────────────────────────────────────────
BACKUP_EXPECT_SCHEMA=engematex
# BACKUP_MIN_BYTES=1024
# BACKUP_MIN_LINES=20
# MEDIA_ALLOW_EMPTY=0

# ─── Prova de decifra da FIELD_ENCRYPTION_KEY ────────────────────────────────
KEY_PROOF_SCHEMA=engematex
# KEY_PROOF_ALLOW_NO_SAMPLE=0

# ─── Drill de restore ─────────────────────────────────────────────────────────
# RESTORE_DB = nome do banco de produção (confira o POSTGRES_DB no env do sq-prod-db).
RESTORE_DB=smartquotation
RESTORE_SCHEMA=engematex
RESTORE_MIN_QUOTATIONS=1
RESTORE_MAX_AGE_HOURS=26
# RESTORE_IMAGE=postgres:15
# RESTORE_WAIT_SECONDS=90
# RESTORE_CHECK_MEDIA=1
