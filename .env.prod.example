# SmartQuotation — produção (docker-compose.prod.yml). Copie para `.env` e preencha.
#   cp .env.prod.example .env   &&   edite os segredos abaixo
# NUNCA commite o .env real. Hosts apontam para os service names do compose (db, redis).

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=smartquotation.settings.production
DJANGO_DEBUG=False
# Gere um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE-ME-strong-random-secret
# Domínios reais que servem a app (vírgula-separado). Inclua os subdomínios de tenant.
DJANGO_ALLOWED_HOSTS=app.seudominio.com,.seudominio.com

# Cifragem de campos (preços/margens + credenciais ERP). OBRIGATÓRIO — production falha sem.
# Gere: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE-ME-fernet-key

# ─── Postgres (service `db` no compose) ───────────────────────────────────────
POSTGRES_DB=smartquotation
POSTGRES_USER=sq
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Redis / Celery (service `redis` no compose) ──────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Storage de mídia (propostas PDF/DOCX) ────────────────────────────────────
# USE_S3=False  → arquivos salvos em media_data (named volume Docker, /app/backend/media).
#               Adequado para servidor único. Não perde arquivos em restart/redeploy.
# USE_S3=True   → arquivos enviados ao S3. Use quando tiver múltiplas réplicas do web/worker
#               ou quiser offload de storage. Preencha AWS_* abaixo e remova o "#".
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# Intervalo do pull Protheus (minutos).
PROTHEUS_PULL_INTERVAL_MINUTES=15

# ─── Backup ───────────────────────────────────────────────────────────────────
# Diretório onde scripts/backup_db.sh salva os dumps (.sql.gz).
POSTGRES_BACKUP_DIR=/backups/sq
# Diretório onde scripts/backup_media.sh salva os arquivos de mídia (PDFs/DOCX).
# Deve coincidir com POSTGRES_BACKUP_DIR para que DB e mídia fiquem no mesmo local
# e o restore seja consistente. scripts/backup_media.sh usa BACKUP_DIR (override
# pontual) → MEDIA_BACKUP_DIR (configuração persistente) → /backups/sq (padrão).
MEDIA_BACKUP_DIR=/backups/sq
# scripts/backup_db.sh detecta sozinho compose vs. container avulso (produção real).
# Só defina o que precisar sobrepor:
# BACKUP_MODE=auto            # auto (default) | container | compose
# DB_CONTAINER=sq-prod-db     # nome do container avulso de produção
# DB_CONTAINER_PORT=5436      # porta do Postgres DENTRO do container (produção real)
# DOCKER="sudo docker"        # só para execução MANUAL pelo usuário de deploy (fora do grupo
#                             # docker). As units systemd não leem este arquivo e rodam
#                             # como root, sem sudo (ver o aviso no fim desta seção).
# Validação por conteúdo do dump (evita o gotcha de backup vazio com exit code 0):
# BACKUP_MIN_BYTES=1024
# BACKUP_MIN_LINES=20
# BACKUP_EXPECT_SCHEMA=engematex
# Retenção local de sq_*.sql.gz e media_*.tar.gz (dias; 0 desliga). Só poda depois de um
# backup novo validado e nunca o mais novo.
# BACKUP_RETENTION_DAYS=14
# scripts/backup_media.sh — container avulso da app (produção real) e mídia vazia:
# MEDIA_CONTAINER=sq-web-proto
# MEDIA_ALLOW_EMPTY=0

# As units systemd de backup NÃO leem este arquivo: usam /etc/smartquotation/backup.env,
# só com variáveis de backup (modelo em ops/systemd/backup.env.example, com KEY_BACKUP_DIR,
# RESTORE_* e afins). Este arquivo contém a FIELD_ENCRYPTION_KEY: ele próprio é material de
# chave e segue a custódia separada da chave (docs/INFRASTRUCTURE.md §6), nunca o dump.
